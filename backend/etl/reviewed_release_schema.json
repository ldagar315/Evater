  "constraints": [
    "CHECK (((char_length(TRIM(BOTH FROM question_text)) >= 10) AND (char_length(TRIM(BOTH FROM question_text)) <= 5000)))",
    "CHECK (((correct_option_id IS NULL) OR (correct_option_id = ANY (ARRAY['A'::text, 'B'::text, 'C'::text, 'D'::text]))))",
    "CHECK (((estimated_time_seconds >= 10) AND (estimated_time_seconds <= 600)))",
    "CHECK (((explanation IS NULL) OR ((char_length(TRIM(BOTH FROM explanation)) >= 5) AND (char_length(TRIM(BOTH FROM explanation)) <= 5000))))",
    "CHECK (((quality_score >= (0)::numeric) AND (quality_score <= (1)::numeric)))",
    "CHECK ((cognitive_level = ANY (ARRAY['recall'::text, 'understand'::text, 'apply'::text, 'analyze'::text])))",
    "CHECK ((difficulty = ANY (ARRAY['easy'::text, 'medium'::text, 'hard'::text])))",
    "CHECK ((jsonb_typeof(answer_spec) = 'object'::text))",
    "CHECK ((jsonb_typeof(generation_spec) = 'object'::text))",
    "CHECK ((jsonb_typeof(media_json) = 'array'::text))",
    "CHECK ((jsonb_typeof(option_media_json) = 'object'::text))",
    "CHECK ((jsonb_typeof(options_json) = 'array'::text))",
    "CHECK ((jsonb_typeof(render_config) = 'object'::text))",
    "CHECK ((marks > 0))",
    "CHECK ((question_style = ANY (ARRAY['direct'::text, 'scenario'::text, 'experiment'::text, 'data'::text, 'diagram'::text])))",
    "CHECK ((question_type = ANY (ARRAY['mcq_single'::text, 'mcq_multi'::text, 'assertion_reason'::text, 'true_false'::text, 'fill_blank'::text, 'numerical'::text, 'case_study'::text, 'diagram_based'::text, 'matching'::text])))",
    "CHECK ((status = ANY (ARRAY['draft'::text, 'validated'::text, 'review'::text, 'published'::text, 'rejected'::text, 'retired'::text])))",
    "FOREIGN KEY (chapter_id) REFERENCES chapters(id) ON DELETE RESTRICT",
    "FOREIGN KEY (concept_id) REFERENCES concepts(id) ON DELETE RESTRICT",
    "FOREIGN KEY (curriculum_version_id) REFERENCES curriculum_versions(id) ON DELETE RESTRICT",
    "FOREIGN KEY (ingestion_job_id) REFERENCES ingestion_jobs(id) ON DELETE SET NULL",
    "FOREIGN KEY (reviewed_by) REFERENCES auth.users(id) ON DELETE SET NULL",
    "FOREIGN KEY (source_id) REFERENCES content_sources(id) ON DELETE SET NULL",
    "PRIMARY KEY (id)",
    "UNIQUE (chapter_id, content_hash)"
  ]
}
